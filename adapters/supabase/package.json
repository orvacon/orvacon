{
  "name": "@orvacon/adapter-supabase",
  "version": "0.1.2",
  "description": "Supabase database adapter for orvacon — direct Postgres connection (transactions, advisory locks) + default-deny RLS generation.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@orvacon/paykit": ">=0.1.1 <1.0.0",
    "postgres": "^3"
  },
  "devDependencies": {
    "@orvacon/paykit": "workspace:*",
    "@orvacon/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "postgres": "^3.4.5",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "orvacon",
    "payments",
    "payment-orchestration",
    "typescript",
    "iyzico"
  ]
}
