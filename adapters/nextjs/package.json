{
  "name": "@orvacon/adapter-nextjs",
  "version": "0.1.2",
  "description": "Next.js App Router adapter for orvacon — the gateway callback route handler, with after()-drained signed-webhook delivery.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "check-types": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orvacon/orvacon.git",
    "directory": "adapters/nextjs"
  },
  "homepage": "https://orvacon.com",
  "keywords": [
    "orvacon",
    "payments",
    "payment-orchestration",
    "typescript",
    "iyzico"
  ],
  "peerDependencies": {
    "@orvacon/paykit": ">=0.1.1 <1.0.0",
    "next": ">=15"
  },
  "devDependencies": {
    "@orvacon/paykit": "workspace:*",
    "@orvacon/tsconfig": "workspace:*",
    "next": "16.3.2",
    "typescript": "7.0.2"
  }
}
