{
  "name": "@orvacon/ui-library",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "bun run registry && next dev",
    "build": "bun run registry:serve && bun run registry && next build",
    "start": "next start",
    "check-types": "bun run registry && tsc --noEmit",
    "registry": "bun scripts/build-registry.ts",
    "registry:serve": "orvacon registry build registry.json --output public/r"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
