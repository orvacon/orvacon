{
  "name": "@orvacon/vaultkit",
  "version": "0.0.0",
  "description": "Saved cards on file: vault, re-charge, and forget cards through the gateway, statelessly.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orvacon/orvacon.git",
    "directory": "packages/vaultkit"
  },
  "homepage": "https://orvacon.com",
  "keywords": [
    "orvacon",
    "payments",
    "vault",
    "saved-cards",
    "tokenization",
    "typescript"
  ],
  "peerDependencies": {
    "@orvacon/paykit": ">=0.4.0 <1.0.0"
  },
  "devDependencies": {
    "@orvacon/paykit": "workspace:*",
    "@orvacon/testkit": "workspace:*",
    "@orvacon/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
