{
  "name": "@orvacon/subkit",
  "version": "0.0.0",
  "description": "Recurring charges for orvacon — a stateless subscription state machine with renewal, dunning, and cancel.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orvacon/orvacon.git",
    "directory": "packages/subkit"
  },
  "homepage": "https://orvacon.com",
  "keywords": [
    "orvacon",
    "payments",
    "subscriptions",
    "recurring",
    "billing",
    "dunning",
    "typescript"
  ],
  "dependencies": {
    "@orvacon/dunningkit": ">=0.0.0 <1.0.0"
  },
  "peerDependencies": {
    "@orvacon/paykit": ">=0.4.0 <1.0.0"
  },
  "devDependencies": {
    "@orvacon/paykit": "workspace:*",
    "@orvacon/testkit": "workspace:*",
    "@orvacon/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "5.9.2"
  }
}
