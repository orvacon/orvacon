{
  "name": "@orvacon/cryptokit",
  "version": "0.1.1",
  "description": "Zero-dependency cryptographic primitives for orvacon: Ed25519 signing, HMAC-SHA256, SHA-256, HKDF, timing-safe comparison, and the signed-webhook envelope. Web Crypto only.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@orvacon/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "orvacon",
    "payments",
    "payment-orchestration",
    "typescript",
    "iyzico"
  ]
}
