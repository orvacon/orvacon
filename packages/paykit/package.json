{
  "name": "@orvacon/paykit",
  "version": "0.2.0",
  "description": "Provider-agnostic, TypeScript-first payment orchestration core.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connector": {
      "types": "./dist/connector.d.ts",
      "import": "./dist/connector.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@orvacon/cryptokit": "^0.1.1"
  },
  "devDependencies": {
    "@orvacon/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "orvacon",
    "payments",
    "payment-orchestration",
    "typescript",
    "iyzico"
  ]
}
