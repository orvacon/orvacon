{
  "name": "@orvacon/paykit",
  "version": "0.3.0",
  "description": "Provider-agnostic, TypeScript-first payment orchestration core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connector": {
      "types": "./dist/connector.d.ts",
      "import": "./dist/connector.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orvacon/orvacon.git",
    "directory": "packages/paykit"
  },
  "homepage": "https://orvacon.com",
  "keywords": [
    "orvacon",
    "payments",
    "payment-orchestration",
    "typescript",
    "iyzico"
  ],
  "dependencies": {
    "@orvacon/cryptokit": "^0.1.1"
  },
  "devDependencies": {
    "@orvacon/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
