{
  "name": "@orvacon/taxkit",
  "version": "0.0.0",
  "description": "Add tax (VAT / KDV) to every authorize — an orvacon plugin.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@orvacon/paykit": ">=0.4.0 <1.0.0"
  },
  "devDependencies": {
    "@orvacon/paykit": "workspace:*",
    "@orvacon/testkit": "workspace:*",
    "@orvacon/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "orvacon",
    "payments",
    "tax",
    "vat",
    "kdv",
    "plugin",
    "typescript"
  ]
}
