{
  "name": "@orvacon/notifykit",
  "version": "0.0.0",
  "description": "Notify customers on payment lifecycle events — an orvacon plugin.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orvacon/orvacon.git",
    "directory": "packages/notifykit"
  },
  "homepage": "https://orvacon.com",
  "keywords": [
    "orvacon",
    "payments",
    "notifications",
    "webhooks",
    "plugin",
    "typescript"
  ],
  "peerDependencies": {
    "@orvacon/paykit": ">=0.4.0 <1.0.0"
  },
  "devDependencies": {
    "@orvacon/paykit": "workspace:*",
    "@orvacon/testkit": "workspace:*",
    "@orvacon/tsconfig": "workspace:*",
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  }
}
